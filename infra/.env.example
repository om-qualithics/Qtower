# Copy to infra/.env and fill in local values. Never commit the real .env.

# --- Postgres ---
POSTGRES_DB=misty
POSTGRES_USER=misty
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Superuser connection - used ONLY by Alembic for schema migrations.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://misty:changeme@localhost:5432/misty

# Restricted, non-superuser role - used by the API/Celery at runtime.
# Required so Postgres Row-Level Security is actually enforced (the
# superuser role above unconditionally bypasses RLS). Auto-created by
# infra/postgres-init/01-app-role.sh on first container init.
APP_DB_USER=misty_app
APP_DB_PASSWORD=changeme-app
DATABASE_URL=postgresql+psycopg://misty_app:changeme-app@localhost:5432/misty

# Runtime connection pool sizing (tunable per deployment without a code
# change - see aboutproject.md Milestone 4 scalability notes).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Redis (Celery broker + cache) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=misty-admin
MINIO_ROOT_PASSWORD=changeme-too
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=misty

# --- App / API ---
JWT_SIGNING_KEY=dev-only-change-me
PUBLIC_HOSTNAME=localhost
API_PORT=8000
WEB_PORT=3000
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000

# --- TLS (unused locally; present for prod/AWS parity per handoff §6) ---
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- AI Gateway ---
# "mock" (default, no external calls) or "live" (real calls via LiteLLM).
AI_PROVIDER=mock
# LiteLLM model string - the vendor prefix selects which SDK LiteLLM calls
# under the hood, e.g. "anthropic/claude-sonnet-5", "openai/gpt-4o",
# "gemini/gemini-2.0-flash". Switching vendors = changing this + AI_API_KEY,
# no code change.
AI_MODEL=anthropic/claude-sonnet-5
AI_API_KEY=

# --- Identity: Jackson (SAML/OIDC + SCIM broker, formerly BoxyHQ) ---
JACKSON_DB_NAME=jackson
JACKSON_PORT=5225
JACKSON_BASE_URL=http://localhost:5225
# 32-character key used to encrypt connection secrets at rest in Jackson's DB.
JACKSON_DB_ENCRYPTION_KEY=
# Shared secret our backend uses to call Jackson's admin API.
JACKSON_API_KEYS=
JACKSON_NEXTAUTH_SECRET=
# email:password - logs into Jackson's own admin portal (debugging only,
# separate from our app's users). Leave blank to disable that portal.
JACKSON_ADMIN_CREDENTIALS=
# Where Jackson POSTs SCIM directory-sync events. host.docker.internal
# reaches the API when it's running natively on the host (native Windows
# dev per Milestone 1), not inside docker-compose.
JACKSON_WEBHOOK_URL=http://host.docker.internal:8000/identity/scim/webhook
JACKSON_WEBHOOK_SECRET=

# Break-glass local login, independent of Jackson/SAML - lets an operator
# always get in even if the SSO connection is broken/misconfigured. Blank
# = disabled entirely. Set via
# python -m apps.api.scripts.set_super_admin_password (writes both values
# below for you - never edit SUPER_ADMIN_PASSWORD_HASH by hand).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=

# --- Identity: mock SAML IdP (dev only, until a real Entra/Google tenant
# is available - see aboutproject.md). Generate via
# infra/scripts/gen-mock-saml-cert.sh and paste the two values below. ---
MOCK_SAML_PORT=4000
MOCK_SAML_PUBLIC_KEY=
MOCK_SAML_PRIVATE_KEY=

# --- Licensing ---
# Public half of the RSA keypair used to verify license files (safe to
# embed in every deployment - it can only verify, never sign). Generate
# the keypair via infra/scripts/gen-license-keypair.sh; the private half
# stays in the gitignored secrets/ directory and is never shipped.
LICENSE_PUBLIC_KEY=
# A signed license token for this deployment. Generate via
# apps/api/scripts/generate_license.py once the keypair exists.
LICENSE_TOKEN=
